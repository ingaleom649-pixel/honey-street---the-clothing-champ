# Honeystreet Environment Variables
# ==================================
# Copy this file to .env and fill in real values.
# NEVER commit real secrets to version control.

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000

# Secret keys (change these in production!)
SECRET_KEY=change-this-super-secret-key-in-production
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=120

# Database (SQLite for dev. For PostgreSQL/MySQL override DATABASE_URL)
DATABASE_URL=sqlite:///honeystreet.db

# Admin bootstrap credentials (set secure values in production)
ADMIN_NAME=Honeystreet Admin
ADMIN_EMAIL=admin@honeystreet.com
ADMIN_PASSWORD=Admin@123

# Social / Professional Profiles
LINKEDIN_URL=https://www.linkedin.com/in/om-ingale-874a53427
INSTAGRAM_URL=https://www.instagram.com/
GITHUB_URL=https://github.com/

# Payment gateway placeholders (integrate later)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
